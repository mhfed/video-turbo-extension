{
  "manifest_version": 3,
  "name": "Video Turbo",
  "version": "1.1.0",
  "description": "Điều khiển tốc độ và trình phát video trên YouTube cùng hầu hết website.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Video Turbo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
